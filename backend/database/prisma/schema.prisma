datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TelemetryLog {
  id            Int      @id @default(autoincrement())
  droneCode     String   @map("drone_code")
  hazardType    String   @map("hazard_type")    // 'fire', 'flood', 'landslide', 'beacon'
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  batteryLevel  Int      @map("battery_level")
  payload       Json?    // Flexible: stores ML confidence/bounding boxes for fire, or water level / sensor metrics for others
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("telemetry_logs")
}


model FireDetection {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  label        String   // "fire" or "smoke"
  confidence   Float    // YOLO detection confidence
  bboxX1       Float    // Top-left X coordinate (%)
  bboxY1       Float    // Top-left Y coordinate (%)
  bboxX2       Float    // Bottom-right X coordinate (%)
  bboxY2       Float    // Bottom-right Y coordinate (%)
  severity     String   @default("MODERATE") // "Minor", "Moderate", or "Severe"
  severityConf Float?   // Secondary classifier confidence
  trend        String?  @default("STABLE")   // "GROWING", "STABLE", "DIMINISHING", or "MONITORING"
  trendSlope   Float?   // Numerical regression slope from np.polyfit
  threatScore  Int?     // Fusion urgency score (0-100)
  createdAt    DateTime @default(now())
}