datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TelemetryLog {
  id            Int      @id @default(autoincrement())
  droneCode     String   @map("drone_code")
  hazardType    String   @map("hazard_type")    // 'fire', 'flood', 'landslide', 'beacon'
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  batteryLevel  Int      @map("battery_level")
  payload       Json?    // Flexible: stores ML confidence/bounding boxes for fire, or water level / sensor metrics for others
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("telemetry_logs")
}


model FrameAssessment {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())
  
  // Fire-specific metrics
  fireDetected     Boolean  @default(false)
  fireConfidence   Float?
  fireSeverity     String?  // "Minor", "Moderate", or "Severe"
  fireSeverityConf Float?   // Secondary classifier confidence
  fireTrend        String?  // "GROWING", "STABLE", or "DIMINISHING"
  fireTrendSlope   Float?   // Numerical regression slope for fire
  
  // Smoke-specific metrics
  smokeDetected    Boolean  @default(false)
  smokeConfidence  Float?
  smokeTrend       String?  // "EXPANDING", "STABLE", or "DISPERSING" (Plume dynamics)
  smokeTrendSlope  Float?   // Numerical regression slope for smoke
  
  // Decision Fusion
  threatScore      Int?     // Fusion urgency score (0-100)
  
  // Raw bounding boxes stored as JSON for your canvas overlays
  boxes            Json?

  createdAt        DateTime @default(now())
}

// One flood sensor packet as the dashboard received it over USB (see frontend floodSerial.js)
model FloodReading {
  id          String   @id @default(uuid())
  recordedAt  DateTime // when the ground station delivered it
  nodeId      String   // sensor node id; "USB" for a plain USB ultrasonic sensor
  seq         Int?     // node packet counter (restarts when the node reboots)
  source      String   // "lora" (via ground station), "usb" (node plugged in) or "serial" (plain sensor)

  // Depth
  distanceCm  Float?   // air-calibrated echo distance; null when the sensor got no echo
  heightCm    Float?   // flood height using the mount settings below
  mount       String   // "float" or "fixed"
  medium      String   // what the sound travelled through: "water" or "air"
  probeDepthCm Float?
  referenceCm Float?

  // Radio link
  rssi        Float?
  snr         Float?
  lost        Int?     // packets the node knows were lost

  // Node GPS
  gpsFix      Boolean  @default(false)
  latitude    Float?
  longitude   Float?
  satellites  Int?

  createdAt   DateTime @default(now())

  @@index([nodeId, recordedAt])
  @@index([recordedAt])
}